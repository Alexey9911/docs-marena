{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Havn Finance",
  "logo": {
    "light": "/images/logo_black.svg",
    "dark": "/images/logo_white.svg",
    "href": "https://havnfinance.cc"
  },
  "favicon": "/favicon.png",
  "colors": {
    "primary": "#001DED",
    "light": "#4D66FF",
    "dark": "#000A54"
  },
  "appearance": {
    "default": "dark"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "icon": "laptop",
          "href": "https://havnfinance.cc"
        },
        {
          "anchor": "Get Your Card",
          "icon": "credit-card",
          "href": "https://havnfinance.cc/login"
        },
        {
          "anchor": "Twitter",
          "icon": "x-twitter",
          "href": "https://x.com/HavnFinance"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "HAVN VISION",
            "pages": [
              "index"
            ]
          },
          {
            "group": "HAVN PROTOCOL",
            "pages": [
              "protocol/what-is-havn",
              "protocol/how-it-works",
              "protocol/features"
            ]
          },
          {
            "group": "CARD ECOSYSTEM",
            "pages": [
              "cards/types",
              "cards/tiers",
              "cards/integration"
            ]
          },
          {
            "group": "ABOUT US",
            "pages": [
              "about/privacy"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Introduction",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Card Operations",
            "pages": [
              "api-reference/endpoint/create-card",
              "api-reference/endpoint/list-cards",
              "api-reference/endpoint/transactions",
              "api-reference/endpoint/freeze-card"
            ]
          },
          {
            "group": "Wallet Operations",
            "pages": [
              "api-reference/endpoint/get-wallet"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get Your Card",
      "href": "https://havnfinance.cc/login"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/HavnFinance",
      "website": "https://havnfinance.cc"
    }
  }
}